/* 
Accounting Connector Enhanced - Modern Styles
Save this as styles.qss in the project folder
*/

QMainWindow {
    background-color: #f5f7fa;
    font-family: 'Segoe UI', 'Roboto', sans-serif;
}

/* Tab styling */
QTabWidget::pane {
    border: 1px solid #d1d9e6;
    background-color: white;
    border-radius: 8px;
    margin-top: 2px;
}

QTabBar::tab {
    background-color: #f0f2f5;
    border: 1px solid #d1d9e6;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 10px 20px;
    margin-right: 2px;
    font-weight: 500;
    color: #5f6368;
}

QTabBar::tab:selected {
    background-color: white;
    border-bottom: 3px solid #2196F3;
    color: #2196F3;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #e8eaed;
    color: #3c4043;
}

/* Button styling */
QPushButton {
    background-color: #2196F3;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 500;
    font-size: 14px;
    min-width: 120px;
    transition: background-color 0.2s;
}

QPushButton:hover {
    background-color: #1976D2;
}

QPushButton:pressed {
    background-color: #0D47A1;
}

QPushButton:disabled {
    background-color: #e0e0e0;
    color: #9e9e9e;
    cursor: not-allowed;
}

/* Form controls */
QLineEdit, QComboBox, QDateEdit {
    padding: 8px 12px;
    border: 2px solid #d1d9e6;
    border-radius: 6px;
    background-color: white;
    font-size: 14px;
    min-height: 36px;
    selection-background-color: #2196F3;
    selection-color: white;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
    border-color: #2196F3;
    outline: none;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: url(down_arrow.png);
    width: 12px;
    height: 12px;
}

/* Group boxes */
QGroupBox {
    font-weight: 600;
    border: 2px solid #e8eaed;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 14px;
    background-color: white;
    font-size: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 10px 0 10px;
    color: #3c4043;
    background-color: white;
}

/* Table styling */
QTableWidget {
    background-color: white;
    alternate-background-color: #f8f9fa;
    gridline-color: #e8eaed;
    border: 1px solid #d1d9e6;
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget::item {
    padding: 8px;
    border-right: 1px solid #e8eaed;
    border-bottom: 1px solid #e8eaed;
}

QTableWidget::item:selected {
    background-color: #2196F3;
    color: white;
}

QHeaderView::section {
    background-color: #f1f3f4;
    padding: 10px;
    border: 1px solid #d1d9e6;
    font-weight: 600;
    color: #3c4043;
}

/* Scroll bars */
QScrollBar:vertical {
    border: none;
    background: #f1f3f4;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #dadce0;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #bdc1c6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Splitter */
QSplitter::handle {
    background-color: #d1d9e6;
    width: 4px;
    height: 4px;
}

QSplitter::handle:hover {
    background-color: #bdc1c6;
}

/* Status bar */
QStatusBar {
    background-color: #f8f9fa;
    color: #5f6368;
    border-top: 2px solid #d1d9e6;
    font-size: 13px;
    padding: 6px;
}

/* List widget for tabs */
QListWidget {
    background-color: white;
    border: none;
    outline: none;
    font-size: 14px;
}

QListWidget::item {
    padding: 12px 16px;
    border-bottom: 1px solid #e8eaed;
    background-color: white;
    color: #3c4043;
}

QListWidget::item:hover {
    background-color: #f8f9fa;
}

QListWidget::item:selected {
    background-color: #2196F3;
    color: white;
    border-left: 4px solid #1976D2;
}

/* Text edit for logs */
QTextEdit {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    font-family: 'Cascadia Code', 'Consolas', monospace;
    font-size: 12px;
    padding: 8px;
}

/* Labels */
QLabel {
    color: #3c4043;
    font-size: 14px;
}

QLabel[title="true"] {
    font-size: 16px;
    font-weight: 600;
    color: #2196F3;
}

/* Checkboxes */
QCheckBox {
    spacing: 8px;
    color: #3c4043;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    border: 2px solid #d1d9e6;
    background-color: white;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    border: 2px solid #2196F3;
    background-color: #2196F3;
    image: url(checkmark.png);
    border-radius: 4px;
}